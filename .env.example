DATABASE_URL=

# اختياري: مفتاح توقيع الجلسات. إن تُرك فارغًا يُشتقّ من DATABASE_URL.
AUTH_SECRET=

# للتشغيل المحلي بلا إنترنت:  npm run db:local  ثم
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
